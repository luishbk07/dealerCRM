# Copia este archivo a .env y completa los valores de tu proyecto Supabase.
# Nunca subas .env al repositorio.

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Origen público de la app (opcional, sin barra final). Ej: https://tudominio.com
VITE_APP_ORIGIN=
