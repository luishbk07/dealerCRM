# Copia este archivo a .env y completa los valores de tu proyecto Supabase.
# Nunca subas .env al repositorio.

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Origen público de la app (sin barra final).
# GitHub Pages: https://luishbk07.github.io/dealerCRM
# Dominio propio futuro: https://tudominio.com
VITE_APP_ORIGIN=

# Base path (Vite). GitHub Pages: /dealerCRM/ — dominio propio: /
VITE_BASE_PATH=
